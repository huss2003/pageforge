    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.3.1",
    "storybook": "10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
