{
  "name": "@pageforge/qa",
  "version": "0.1.0",
  "private": true,
  "description": "Lighthouse, axe and screenshot checks run against draft page previews.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./dispatch": "./src/dispatch.ts"
  },
  "bin": {
    "pageforge-qa": "./bin/pageforge-qa.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "qa": "tsx src/run.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@pageforge/blocks": "workspace:*",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "linkedom": "^0.18.14",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
