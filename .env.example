# Copy to apps/web/.env.local for local development.
# In production these live in Vercel → Project → Settings → Environment Variables.
# Never commit real values. Everything is optional: without keys the site
# serves built-in Hoverline content and the Factory runs in simulation mode.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity — https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_DEMO_DATASET=demo
SANITY_API_WRITE_TOKEN=          # server only (Editor): agents save drafts, seed script
SANITY_API_READ_TOKEN=           # server only (Viewer): draft previews
SANITY_REVALIDATE_SECRET=        # random string; also set on the Sanity webhook

# Supabase — run logs, QA results, leads, rate limits
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=             # server only

# AI models (free tiers)
GEMINI_API_KEY=                  # Google AI Studio
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=                    # fallback when Gemini is rate-limited
GROQ_MODEL=openai/gpt-oss-120b

# Public demo protection — Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Factory
FACTORY_ADMIN_PASSWORD=          # admin login for production publishing
SESSION_SECRET=                  # random 32+ chars, signs the admin cookie
PREVIEW_SECRET=                  # random 32+ chars, signs draft preview links

# QA (GitHub Actions)
GITHUB_QA_DISPATCH_TOKEN=        # fine-grained PAT: this repo, Actions read+write
GITHUB_REPOSITORY=huss2003/pageforge
QA_CALLBACK_SECRET=              # random 32+ chars; same value as the GitHub repo secret
