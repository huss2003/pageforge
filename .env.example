# Copy to apps/web/.env.local for local development.
# In production, set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity (M2) — https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=        # server only: agents save drafts with this
SANITY_API_READ_TOKEN=         # server only: draft-mode previews

# Supabase (M3) — run logs, rate limits
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=           # server only

# AI models (M3) — free tiers
GEMINI_API_KEY=                # Google AI Studio
GROQ_API_KEY=                  # fallback when Gemini is rate-limited

# Public demo protection (M5) — Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# QA trigger (M4) — fine-grained token limited to this repo's Actions
GITHUB_QA_DISPATCH_TOKEN=
