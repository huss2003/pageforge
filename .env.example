# Copy to apps/web/.env.local for local development.
# In production these live in Vercel → Project → Settings → Environment Variables.
# Never commit real values. Everything is optional: without keys the site
# serves built-in Hoverline content and the ABM desk runs in simulation mode
# (FakeLlm drafts, in-memory store, built-in CRM).

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity — https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_DEMO_DATASET=demo
SANITY_API_WRITE_TOKEN=          # server only (Editor): agents save drafts, seed script
SANITY_API_READ_TOKEN=           # server only (Viewer): draft previews
SANITY_REVALIDATE_SECRET=        # random string; also set on the Sanity webhook

# Supabase — ABM campaigns, claims, events, leads, rate limits (migrations 0001 + 0002)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=             # server only

# AI models (free tiers)
GEMINI_API_KEY=                  # Google AI Studio
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=                    # fallback when Gemini is rate-limited
GROQ_MODEL=openai/gpt-oss-120b

# Public demo protection — Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ABM desk
FACTORY_ADMIN_PASSWORD=          # "Workspace password": unlocks the main workspace
SESSION_SECRET=                  # random 32+ chars, signs the pf_abm session cookie
ABM_ALLOW_LOCAL_SOURCES=         # 1 = the source fetcher may read localhost in production (local smoke tests only)

# CRM — HubSpot private app (scopes: crm.objects.contacts.write, crm.objects.companies.write)
HUBSPOT_PRIVATE_APP_TOKEN=       # server only; without it leads stay in the built-in CRM

# Product analytics — PostHog (loaded only after the visitor accepts the consent banner)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
