{
  "name": "pageforge",
  "private": true,
  "description": "AI system that turns a sales brief into a tested, SEO-ready landing page.",
  "author": "Hussain Singapuri",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "seed:sanity": "pnpm --filter @pageforge/web seed:sanity --"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3"
  }
}
